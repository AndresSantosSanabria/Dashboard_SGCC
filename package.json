{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently --names \"vite,scheduler\" --prefix-colors \"blue,yellow\" \"vite\" \"php artisan schedule:work --no-interaction\"",
        "build": "vite build",
        "start": "concurrently --names \"serve,scheduler\" --prefix-colors \"green,yellow\" \"php artisan serve\" \"php artisan schedule:work --no-interaction\"",
        "scheduler": "php artisan schedule:work --no-interaction"
    },
    "devDependencies": {
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "vite": "^7.0.7",
        "vite-plugin-static-copy": "latest"
    },
    "dependencies": {
        "html2canvas": "^1.4.1",
        "jspdf": "^2.5.2",
        "jspdf-autotable": "^3.8.3",
        "sortablejs": "^1.15.7"
    }
}
